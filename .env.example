# Cratewise environment example — only used by device tests, never by the app.
# Copy this file to .env (gitignored) and fill in your own values.
# Never commit .env and never put a real token in this file.

# Live Discogs test (integration_test/discogs_live_test.dart): a Discogs
# personal access token (Discogs → Settings → Developers → Generate new token).
# Run:
#   flutter test integration_test/discogs_live_test.dart -d <device> --dart-define-from-file=.env
# DISCOGS_TEST_TOKEN=
