# Cratewise environment example
# Copy this file to .env for local development.
# Do not commit .env.
# Do not add real secrets to this file.

# Base URL for the Cloudflare Worker Backend-for-Frontend.
CRATE_WORKER_BASE_URL=https://your-worker.your-subdomain.workers.dev

# App scheme used for OAuth callback handling.
CRATE_APP_SCHEME=cratewise

# App environment.
# Allowed examples: local, development, staging, production.
CRATE_ENVIRONMENT=local

# Optional API timeout in milliseconds.
CRATE_API_TIMEOUT_MS=30000

# Discogs values below belong in Cloudflare Worker secrets.
# They are listed here only as a reminder.
# Do not use these in Flutter.
# DISCOGS_CONSUMER_KEY=
# DISCOGS_CONSUMER_SECRET=

# Live Discogs tests (integration_test/discogs_live_test.dart).
# Put a real personal access token in .env (never here), then run:
#   flutter test integration_test/discogs_live_test.dart -d <device> --dart-define-from-file=.env
# DISCOGS_TEST_TOKEN=
