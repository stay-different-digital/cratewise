        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collection_items\" (\"id\" TEXT NOT NULL, \"discogs_release_id\" INTEGER NOT NULL, \"artist\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"label\" TEXT NULL, \"catno\" TEXT NULL, \"format\" TEXT NULL, \"country\" TEXT NULL, \"year\" INTEGER NULL, \"cover_url\" TEXT NULL, \"media_condition\" TEXT NOT NULL, \"sleeve_condition\" TEXT NOT NULL, \"notes\" TEXT NULL, \"tags\" TEXT NOT NULL, \"storage_location\" TEXT NULL, \"sync_status\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
